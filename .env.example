# OAuth2 credentials — create an app at https://developer.ouraring.com
# (redirect URI http://localhost:9876/callback). Oura has deprecated personal
# access tokens, so OAuth2 is the only supported auth.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Run `oura auth` to authorize — it saves tokens to ~/.oura-mcp/config.json.
# These env vars are optional and only override the stored config if set.
OURA_ACCESS_TOKEN=
OURA_REFRESH_TOKEN=

# Optional: set to 1 to default oura_query to Oura's sandbox/demo dataset.
OURA_SANDBOX=
